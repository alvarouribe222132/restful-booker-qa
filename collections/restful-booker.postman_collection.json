    {
      "name": "HealthCheck",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "//Verificar que el SUT responda con el status code 201\r",
              "pm.test('El SUT esta activo (Status 201)', function () {\r",
              "    pm.response.to.have.status(201);\r",
              "});\r",
              "\r",
              "//Verificar que el SUT este activo, sino detener las siguientes pruebas\r",
              "if (pm.response.code !== 201) {\r",
              "    console.log('El SUT esta fuera de servicio. Abortando...');\r",
              "    pm.execution.setNextRequest(null);\r",
              "}\r",
              "\r",
              "// Verificar que el body no este vacio\r",
              "pm.test('El body no está vacío', function () {\r",
              "    pm.expect(pm.response.text()).to.not.be.empty;\r",
              "});\r",
              "\r",
              "//Verificar que el SUT reponda con 'Created'\r",
              "pm.test(\"Respuesta contiene 'Created'\", function () {\r",
              "    pm.expect(pm.response.text()).to.include('Created');\r",
              "});\r",
              "\r",
              "// Verificar el tiempo de respues menor a 2 segundos\r",
              "pm.test('Tiempo de respuesta aceptable', function () {\r",
              "    pm.expect(pm.response.responseTime).to.be.below(2000); // Tiempo de respuesta en milisegundos\r",
              "});\r",
              "\r",
              "// Verificar que el content-type sea texto plano\r",
              "pm.test('Content-Type es texto plano', function () {\r",
              "    pm.expect(pm.response.headers.get('Content-Type')).to.include('text/plain');\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {}
          }
        }
      ],
