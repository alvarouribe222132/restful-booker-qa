    {
      "name": "CreateBooking",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "//Obtener la fecha de hoy para usarla en el CheckIn\r",
              "const hoy = new Date();\r",
              "\r",
              "//Calcular la fecha de hoy + 7 dias para usarla de checkout\r",
              "const futura = new Date();\r",
              "futura.setDate(hoy.getDate() + 7);\r",
              "\r",
              "//Formatear las fechas para que coincidan con el formato de la API\r",
              "const checkin = hoy.toISOString().split('T')[0];\r",
              "const checkout = futura.toISOString().split('T')[0];\r",
              "\r",
              "//Guardar las fechas en variables de entorno\r",
              "pm.environment.set('checkin', checkin);\r",
              "pm.environment.set('checkout', checkout);\r",
              "\r",
              "console.log('Fecha de checkin ' + checkin);\r",
              "console.log('Fecha de checkout ' + checkout)"
            ],
            "type": "text/javascript",
            "packages": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "//Verificar que el SUT responda con el status code 200\r",
              "pm.test('El SUT responde correctamente al crear un token (Status 200)', function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "//Verificar que el cuerpo de la respuesta contenga un id\r",
              "pm.test('El cuerpo de la respuesta contiene un id', function () {\r",
              "    const jsonData = pm.response.json();\r",
              "    pm.expect(jsonData).to.have.property('bookingid');\r",
              "\r",
              "    //Guardar el id en una variable de entorno para su uso posterior\r",
              "    if (jsonData.bookingid) {\r",
              "        pm.environment.set('bookingid', jsonData.bookingid);\r",
              "    }\r",
              "});\r",
              "\r",
              "// Verificar que bookingid sea un numero entero positivo\r",
              "pm.test('El bookingid es un número entero positivo', function () {\r",
              "    const bookingid = pm.response.json().bookingid;\r",
              "    pm.expect(bookingid).to.be.a('number');\r",
              "    pm.expect(bookingid).to.be.above(0);\r",
              "});\r",
              "\r",
              "// Verificar que los datos devueltos coincidan con los enviados en la solicitud\r",
              "pm.test('El cuerpo de la respuesta contiene los datos correctos', function () {\r",
              "    const booking = pm.response.json().booking;\r",
              "    pm.expect(booking.firstname).to.eql(pm.environment.get('firstname'));\r",
              "    pm.expect(booking.lastname).to.eql(pm.environment.get('lastname'));\r",
              "    pm.expect(booking.totalprice).to.eql(parseInt(pm.environment.get('totalprice')));\r",
              "    pm.expect(booking.depositpaid).to.eql(JSON.parse(pm.environment.get('depositpaid')));\r",
              "    pm.expect(booking.bookingdates.checkin).to.eql(pm.environment.get('checkin'));\r",
              "    pm.expect(booking.bookingdates.checkout).to.eql(pm.environment.get('checkout'));\r",
              "    pm.expect(booking.additionalneeds).to.eql(pm.environment.get('additionalneeds'));\r",
              "});\r",
              "\r",
              "// Verificar que el content type es application/json\r",
              "pm.test('El SUT responde con content type application/json', function () {\r",
              "    pm.response.to.have.header('Content-Type', 'application/json; charset=utf-8');\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"firstname\" : \"{{firstname}}\",\r\n    \"lastname\" : \"{{lastname}}\",\r\n    \"totalprice\" : {{totalprice}},\r\n    \"depositpaid\" : {{depositpaid}},\r\n    \"bookingdates\" : {\r\n        \"checkin\" : \"{{checkin}}\",\r\n        \"checkout\" : \"{{checkout}}\"\r\n    },\r\n    \"additionalneeds\" : \"{{additionalneeds}}\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{dominio}}/booking",
          "host": [
            "{{dominio}}"
          ],
          "path": [
            "booking"
          ]
        }
      },
      "response": []
    },
    {
      "name": "GetBooking (id)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "//Verificar que el SUT responda con el status code 200\r",
              "pm.test('El SUT responde correctamente (Status 200)', function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "// Verificar que la respuesta contenga todas las propiedades esperadas\r",
              "pm.test('El cuerpo de la respuesta contiene todas las propiedades esperadas', function () {\r",
              "    const jsonData = pm.response.json();\r",
              "    pm.expect(jsonData).to.have.all.keys('firstname', 'lastname', 'totalprice', 'depositpaid', 'bookingdates', 'additionalneeds');\r",
              "});\r",
              "\r",
              "//verificar que depositpaid es boolean\r",
              "pm.test(\"El campo 'depositpaid' es un booleano\", function () {\r",
              "    pm.expect(pm.response.json().depositpaid).to.be.a('boolean');\r",
              "});\r",
              "\r",
              "// Verificar que la estructura de la respuesta contenga todos los valores correctos\r",
              "pm.test('El cuerpo de la respuesta contiene todos los valores esperados', function () {\r",
              "    const jsonData = pm.response.json();\r",
              "    pm.expect(jsonData.firstname).to.eql(pm.environment.get('firstname'));\r",
              "    pm.expect(jsonData.lastname).to.eql(pm.environment.get('lastname'));\r",
              "    pm.expect(jsonData.totalprice).to.eql(parseInt(pm.environment.get('totalprice')));\r",
              "    pm.expect(jsonData.depositpaid).to.eql(JSON.parse(pm.environment.get('depositpaid')));\r",
              "    pm.expect(jsonData.bookingdates.checkin).to.eql(pm.environment.get('checkin'));\r",
              "    pm.expect(jsonData.bookingdates.checkout).to.eql(pm.environment.get('checkout'));\r",
              "    pm.expect(jsonData.additionalneeds).to.eql(pm.environment.get('additionalneeds'));\r",
              "});\r",
              "\r",
              "// Verificar que los tipos de datos sean los esperados para cada campo\r",
              "pm.test('Los tipos de datos de los campos son correctos', function () {\r",
              "    const jsonData = pm.response.json();\r",
              "    pm.expect(typeof jsonData.firstname).to.eql('string');\r",
              "    pm.expect(typeof jsonData.lastname).to.eql('string');\r",
              "    pm.expect(typeof jsonData.totalprice).to.eql('number');\r",
              "    pm.expect(typeof jsonData.depositpaid).to.eql('boolean');\r",
              "    pm.expect(typeof jsonData.bookingdates.checkin).to.eql('string');\r",
              "    pm.expect(typeof jsonData.bookingdates.checkout).to.eql('string');\r",
              "    pm.expect(typeof jsonData.additionalneeds).to.eql('string');\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {}
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableBodyPruning": true
      },
      "request": {
        "method": "GET",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": ""
        },
        "url": {
          "raw": "{{dominio}}/booking/{{bookingid}}",
          "host": [
            "{{dominio}}"
          ],
          "path": [
            "booking",
            "{{bookingid}}"
          ]
        }
      },
      "response": []
