    {
      "name": "GetBooking (checkin)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "//Calcular la fecha de filtrado\r",
              "const filtrado = new Date(pm.environment.get('checkin'));\r",
              "filtrado.setDate(filtrado.getDate() - 1);\r",
              "\r",
              "pm.environment.set('checkin_filtrado', filtrado.toISOString().split('T')[0]);"
            ],
            "type": "text/javascript",
            "packages": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "//Verificar que el SUT responda con el status code 200\r",
              "pm.test('El SUT responde correctamente al crear un token (Status 200)', function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "// Verificar que la respuesta es un array no un objeto\r",
              "pm.test('La respuesta es un array', function () {\r",
              "    const Body = pm.response.json();\r",
              "    pm.expect(Body).to.be.an('array');\r",
              "});\r",
              "\r",
              "// Verificar que cada elemento del array es un objeto con la propiedad bookingid\r",
              "pm.test('Cada elemento del array es un objeto con la propiedad bookingid', function () {\r",
              "    const Body = pm.response.json();\r",
              "    Body.forEach(function (item) {\r",
              "        pm.expect(item).to.have.property('bookingid');\r",
              "    });\r",
              "});\r",
              "\r",
              "//Validar que el bookincode exista entre la lista de ids de la respuesta\r",
              "pm.test('El bookingid ' + pm.environment.get('bookingid') + ' existe en la lista de bookings', function () {\r",
              "    const Body = pm.response.json();\r",
              "    const bookingExists = Body.some(function (item) {\r",
              "        return item.bookingid === parseInt(pm.environment.get('bookingid'));\r",
              "    });\r",
              "    pm.expect(bookingExists).to.be.true;\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {}
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableBodyPruning": true
      },
      "request": {
        "method": "GET",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": ""
        },
        "url": {
          "raw": "{{dominio}}/booking?checkin={{checkin_filtrado}}",
          "host": [
            "{{dominio}}"
          ],
          "path": [
            "booking"
          ],
          "query": [
            {
              "key": "checkin",
              "value": "{{checkin_filtrado}}"
            }
          ]
        }
      },
      "response": []
    }
