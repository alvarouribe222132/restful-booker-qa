    {
      "name": "Auth-CreateToken",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "//Verificar que el SUT responda con el status code 200\r",
              "pm.test('El SUT responde correctamente al crear un token (Status 200)', function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "//Verificar que el cuerpo de la respuesta contenga un token\r",
              "pm.test('El cuerpo de la respuesta contiene un token', function () {\r",
              "    const jsonData = pm.response.json();\r",
              "    pm.expect(jsonData).to.have.property('token');\r",
              "\r",
              "    //Guardar el token en una variable de entorno para su uso posterior\r",
              "    if (jsonData.token) {\r",
              "        pm.environment.set('token_auth', jsonData.token);\r",
              "    }\r",
              "});\r",
              "\r",
              "// Verificar que el token tiene formato valido (no vacio, string, longitud mayor a 12 caracteres)\r",
              "pm.test('El token es válido', function () {\r",
              "    const token = pm.environment.get('token_auth');\r",
              "    pm.expect(token).to.not.be.empty;\r",
              "    pm.expect(token).to.be.a('string');\r",
              "    pm.expect(token.length).to.be.greaterThan(12);\r",
              "});\r",
              "\r",
              "// Verificar que el content type es application/json\r",
              "pm.test('El SUT responde con content type application/json', function () {\r",
              "    pm.response.to.have.header('Content-Type', 'application/json; charset=utf-8');\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Limpiar token antiguo antes de crear uno nuevo\r",
              "pm.environment.unset('token_auth');\r",
              "console.log('Limpiando el token previo...')"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"username\" : \"{{username}}\",\r\n    \"password\" : \"{{password}}\"\r\n}",
          "options": {
